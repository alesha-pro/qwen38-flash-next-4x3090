# Large model storage. Defaults to ~/.cache/qwen38-flash-next-4x3090/models.
QWEN38_MODELS_ROOT=/mnt/ssd/models

# MODEL_DIR=/mnt/ssd/models/Qwen3.8-Flash-Next-W4A16
# PLE_MODEL_DIR=/mnt/ssd/models/Qwen3.8-Flash-Next-NVFP4

HOST=127.0.0.1
PORT=8018
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=512
GPU_MEMORY_UTILIZATION=0.92
KV_CACHE_DTYPE=fp8_e4m3
CONTAINER_NAME=qwen38-flash-next-4x3090
ALLOW_BUSY_GPU=0
SKIP_SMOKE=0
